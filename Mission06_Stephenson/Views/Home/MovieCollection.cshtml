@model IEnumerable<Mission06_Stephenson.Models.Movie>

<h2 class="text-center">Joel Hilton Movie Collection</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
    <tr>
        <th>Title</th>
        <th>Category</th>
        <th>Rating</th>
        <th>Year</th>
        <th>Director</th>
        <th>Edited</th>
        <th>Copied to Plex</th>
        <th>Lent to</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Category.CategoryName</td>  <!-- Display the category name -->
            <td>@movie.Year</td>
            <td>@movie.Rating</td>
            <td>@movie.Director</td>
            <td>@(movie.Edited ? "Yes" : "No")</td>
            <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
            <td>@movie.LentTo</td>
            <td>
                <a href="@Url.Action("EditMovie", "Home", new { id = movie.MovieId })" class="btn btn-warning btn-sm">Edit</a>
                <a href="@Url.Action("DeleteMovie", "Home", new { id = movie.MovieId })" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<a href="@Url.Action("AddMovie", "Home")" class="btn btn-primary">Add New Movie</a>
